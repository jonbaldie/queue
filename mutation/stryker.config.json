{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/**/*.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "deno test --allow-read --allow-write --allow-net --allow-env --allow-run --no-check --ignore=tests/compiled_binary_test.ts"
  },
  "reporters": ["json", "clear-text"],
  "jsonReporter": {
    "fileName": "mutation/stryker-report.json"
  },
  "coverageAnalysis": "off",
  "timeoutMS": 30000,
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": null
  }
}
